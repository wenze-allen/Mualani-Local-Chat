anguage":"zh-CN","revision_id":"OSCBWin6.7.54","source_text_sha256":"50cc857db30b786bf97f71424710b7aa98877ef22502f321fc59329019802d01"}],"evidence_bundle_sha256":"4ce5894e2321b195b982cfcb010336f8507e11ef45878b25e6c03c9c2378adba","review":{"cross_language_conflicts":["Fandom正文及本地任务称远征已经归来；BWiki正文仍将远征队描述为在安瓦蒂尼尔湖一带扎营，并仅称部分成员返回蒙德。两者对远征队当前整体状态及人员构成的表述不完全一致。","Fandom正文称第七小队已正式化且芙蕾德莉卡已任队长；BWiki正文仍称该名称暂定、正式队长尚未确定。"],"uncertain_claims":["远征归来后仍驻留或再次前往 Nod-Krai 的具体人员构成，现有证据无法完整确定。"],"missing_evidence":[],"needs_human_review":true}}