# Install a CUDA-compatible PyTorch build separately, then install requirements.txt.
TRAIN_PYTHON=python3
TRAIN_ROOT=training/work
DATASET_DIR=dataset/work/training_data/sft_zh_chat_v2

MODEL_4B_REPO=huihui-ai/Huihui-Qwen3.5-4B-abliterated
MODEL_9B_REPO=huihui-ai/Huihui-Qwen3.5-9B-abliterated
MODEL_4B_DIR=training/work/models/base/Huihui-Qwen3.5-4B-abliterated
MODEL_9B_DIR=training/work/models/base/Huihui-Qwen3.5-9B-abliterated

MAX_LENGTH=2048
NUM_EPOCHS=2
LEARNING_RATE=3e-5
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
SEED=3407
PER_DEVICE_BATCH_4B=2
GRAD_ACCUM_4B=8
PER_DEVICE_BATCH_9B=1
GRAD_ACCUM_9B=16
GGUF_QUANT=Q4_K_M
LLAMA_CPP_REPO=https://github.com/ggml-org/llama.cpp.git
LLAMA_CPP_REVISION=e9fa0781f1c25fc4fe8c86be1edc6970661ad6f0
